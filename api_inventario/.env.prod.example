# =============================================================================
# Plantilla de producción. Copiar a .env.prod en la EC2 y completar.
#   cp .env.prod.example .env.prod
# NUNCA subir .env.prod al repositorio (ya está en .gitignore).
# =============================================================================

# Red
HOST_PORT=8083
SERVER_PORT=8083

# ---- RDS / MySQL ----
DB_HOST=mi-inventario.abcdefghijkl.us-east-1.rds.amazonaws.com
DB_PORT=3306
DB_NAME=inventario_db
DB_USER=admin
DB_PASSWORD=CAMBIAR_PASSWORD_RDS

# ---- AWS S3 real ----
AWS_REGION=us-east-1
AWS_S3_BUCKET_NAME=mi-bucket-inventario-prod

# Si la EC2 tiene un IAM Role con permisos de S3, dejá estas 3 vacías.
# Si usás un usuario IAM con access key, completá las 2 primeras (SESSION_TOKEN puede quedar vacío).
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_SESSION_TOKEN=

# IMPORTANTE: vacío = AWS real. NO poner http://localhost:8333 acá.
AWS_S3_ENDPOINT=

# ---- Spring / JVM (opcional) ----
SPRING_PROFILES_ACTIVE=prod
SPRING_JPA_HIBERNATE_DDL_AUTO=update
JAVA_TOOL_OPTIONS=-Xms256m -Xmx512m -Djava.awt.headless=true
TZ=UTC
